# ==============================================================================
# RIKSA Backend Production & Development Environment Configuration
# ==============================================================================

# --- Application Server ---
PORT=8080

# --- PostgreSQL Database ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=riksa_db
DB_USER=riksa_user
DB_PASSWORD=riksaPass123

# --- Redis Cache & Session Store ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=riksaRedis123
REDIS_KEY_PREFIX=riksa:local

# --- JWT Security Tokens ---
# Generate a strong 256-bit+ random secret in production (e.g., openssl rand -hex 64)
JWT_SECRET=CHANGE-ME-IN-PRODUCTION-MUST-BE-256-BITS-OR-LONGER
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# --- Media Storage & Persistent Uploads ---
MEDIA_STORAGE_DIR=/app/uploads/media
MEDIA_MAX_BYTES=2097152
# Set when running behind an SSL proxy or CDN (e.g. https://api.riksa.app)
MEDIA_PUBLIC_BASE_URL=

# --- CORS Allowed Origins ---
# Comma-separated domains permitted to reach the API via browser
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://admin.riksa.app,https://riksa.app

# --- AI Educational Study Coach (OpenRouter / Gemini) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Fast Authentication (Google & Telegram) ---
GOOGLE_CLIENT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=@riksaofficialbot
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTH_REQUEST_EXPIRATION_MINUTES=10
TELEGRAM_LOGIN_CODE_EXPIRATION_MINUTES=5
# Local dev: true pulls bot updates without a public webhook URL (leave TELEGRAM_WEBHOOK_URL empty)
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_APP_URL=


# --- Email Verification (Resend) ---
# Leave disabled until a sender domain is verified in Resend.
RESEND_ENABLED=false
RESEND_API_KEY=
# Example after verifying the domain: Riksa <no-reply@auth.example.com>
RESEND_FROM=
# Public HTTPS URL, e.g. https://api.example.com/email-verification.html
RESEND_CONFIRMATION_URL=
