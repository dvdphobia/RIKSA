# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=riksa_db
DB_USER=riksa_user
DB_PASSWORD=your-secure-db-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=your-secure-redis-password
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false
REDIS_KEY_PREFIX=riksa:dev
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s
REDIS_RATE_LIMIT_ENABLED=true
REDIS_OTP_ENABLED=true
REDIS_CACHE_ENABLED=true
REDIS_LEADERBOARD_ENABLED=true

# JWT
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-256-bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OTP
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_CODE_LENGTH=6
OTP_HASH_SECRET=use-a-separate-random-secret-in-production

# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your-bot-username
TELEGRAM_WEBHOOK_URL=https://api.example.com/api/v1/auth/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
TELEGRAM_AUTH_REQUEST_EXPIRATION_MINUTES=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_TRUST_FORWARD_HEADERS=false

# Login Lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Server
PORT=8080
